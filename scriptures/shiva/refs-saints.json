   "confirmed": true
  },
  {
   "text": "Periya Puranam (Sekkizhar, Tirumurai 12)",
   "ref": "Sambandar puranam (PP no. 28), verse 68",
   "first_words_ta": "எண்ணரிய சிவஞானத் தின்னமுதம் குழைத்தருளி",
   "gist": "Uma feeds the child the milk of Siva-wisdom; the child is thus called the one taken into the Lord's service (Kazhi milk of Uma).",
   "url": "https://thevaaram.org/thirumurai_1/onepage.php?thiru=12&Song_idField=12280",
   "confirmed": true
  },
  {
   "text": "Periya Puranam (Sekkizhar, Tirumurai 12)",
   "ref": "Sambandar puranam (PP no. 28), verse 76",
   "first_words_ta": "செம்மைபெற எடுத்ததிருத் தோடுடைய செவியன்எனும்",
   "gist": "The child sings the Todudaiya Seviyan hymn and points out the Lord to his father as the one who did this.",
   "url": "https://thevaaram.org/thirumurai_1/onepage.php?thiru=12&Song_idField=12280",
   "confirmed": true
  },
  {
   "text": "Periya Puranam (Sekkizhar, Tirumurai 12)",
   "ref": "Sambandar puranam (PP no. 28), verse 764",
